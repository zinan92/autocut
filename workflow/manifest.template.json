{
  "projectName": "host-overlay-example",
  "sourceVideo": "/path/to/source-video.mp4",
  "transcriptPath": "remotion-host-overlay-work/transcript/source.json",
  "outputOrientation": "auto",
  "stylePreset": "host-overlay",
  "storyboardPath": "remotion-host-overlay-demo/src/storyboard.json",
  "autocut": {
    "enabled": true,
    "silenceThresholdSec": 0.5,
    "fillerMode": "mark",
    "requiresReview": true
  },
  "editPlan": {
    "strategyConfirmationRequired": true,
    "preserveOriginalOrder": true,
    "destructiveCutsRequireReview": true
  },
  "lengthPolicy": {
    "defaultRangeMinutes": "5-10",
    "singleCompositionMaxMinutes": 10,
    "segmentLengthSeconds": 60,
    "maxSegmentLengthSeconds": 120,
    "visualBeatEverySeconds": 20
  },
  "render": {
    "codec": "h264",
    "crf": 18,
    "concurrency": 2,
    "autoSegmentLongVideos": true,
    "segmentThresholdSeconds": 300,
    "segmentSeconds": 60
  },
  "delivery": {
    "crf": 18,
    "preset": "medium",
    "audioBitrate": "192k",
    "telegramRequiresExplicitMetadata": true
  },
  "attentionPolicy": {
    "maxActivePrimaryAnimation": 1,
    "allowPersistentPassiveContext": true,
    "rule": "Only one primary visual region should update at a time. Previous concept animations should freeze, dim, or fade out when the next concept appears."
  },
  "audio": {
    "sfxMode": "remotion-assets",
    "backgroundMusic": {
      "enabled": false,
      "path": "public/music/background.mp3",
      "volume": 0.06,
      "duckUnderSpeech": true
    },
    "sfx": [
      {
        "name": "phase-hit",
        "path": "public/sfx/phase-hit.wav",
        "usage": "major phase start",
        "volume": 0.18
      },
      {
        "name": "soft-whoosh",
        "path": "public/sfx/soft-whoosh.wav",
        "usage": "single primary visual transition",
        "volume": 0.12
      },
      {
        "name": "tick",
        "path": "public/sfx/tick.wav",
        "usage": "small emphasis",
        "volume": 0.12
      }
    ]
  },
